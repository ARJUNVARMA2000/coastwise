# Copy to .env. Local runs load it automatically; process environment takes precedence.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_PROVIDER=
# Optional path to a customized three-table field contract.
COASTWISE_CONTRACT=
# These are generated privately in the real .env for hosted workspace access.
COASTWISE_ACCESS_PASSWORD=
COASTWISE_SESSION_SECRET=

